# errforge Sovereign AI Stack Environment
# Copy this file to .env and customize

# === Ollama ===
OLLAMA_HOST=0.0.0.0

# === Open WebUI ===
WEBUI_AUTH=False

# === AnythingLLM ===
# STORAGE_DIR is handled by volume

# === Qdrant ===
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# === Optional: Add your API keys here for tools that need them ===
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# === Network / Traefik (when you add reverse proxy) ===
# DOMAIN=yourdomain.com
# EMAIL=you@yourdomain.com
